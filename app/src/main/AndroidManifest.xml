<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Smart Pantry Manager - Student: Richard Jansen van Rensburg (Change to your details)
        Module: Mobile App Development 700

        NOTE: No location, GPS or mapping permissions are requested anywhere in this app.
        The scope of the app is strictly the user's own pantry and recipe matching.
    -->

    <application
        android:name=".PantryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantry"
        tools:targetApi="31">

        <!-- Single host Activity: hosts the Pantry, Suggestions, Almost There
             and Settings fragments inside a navigation drawer. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Add / Edit Ingredient form. Receives the ingredient id through an Intent extra. -->
        <activity
            android:name=".ui.AddEditIngredientActivity"
            android:exported="false"
            android:label="@string/title_ingredient_form"
            android:parentActivityName=".ui.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.MainActivity" />
        </activity>

        <!-- Recipe detail screen. Receives the recipe id through an Intent extra. -->
        <activity
            android:name=".ui.RecipeDetailActivity"
            android:exported="false"
            android:label="@string/title_recipe_detail"
            android:parentActivityName=".ui.MainActivity">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.MainActivity" />
        </activity>
    </application>

</manifest>
