<?xml version="1.0" encoding="utf-8"?>
<!--
    Bonus "Almost There" screen: recipes that are exactly one ingredient short. It is deliberately a
    separate screen so that it can never be confused with the strict Suggested Recipes list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/text_almost_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_badge_amber"
        android:padding="10dp"
        android:text="@string/almost_intro"
        android:textColor="@color/grey_900"
        android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_almost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="16dp"
        tools:listitem="@layout/item_recipe" />

    <LinearLayout
        android:id="@+id/group_almost_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.5"
            android:contentDescription="@string/cd_recipe_icon"
            android:src="@drawable/ic_almost" />

        <TextView
            android:id="@+id/text_almost_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/almost_empty_title"
            android:textColor="@color/grey_900"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/almost_empty_body"
            android:textColor="@color/grey_700"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
